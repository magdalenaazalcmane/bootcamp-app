# Copy this file to .env and fill in values as needed. Everything here is
# optional — the app runs fine with no .env file at all.

# Sends a message to a Discord channel whenever a bug's status changes,
# and when a test report is generated (see ANTHROPIC_API_KEY below).
# Create one via Discord: Server Settings -> Integrations -> Webhooks.
# Leave blank to disable Discord alerts.
DISCORD_WEBHOOK_URL=

# Powers the AI-written narrative on generated test reports (a real Claude
# API call, summarizing that run's actual pass/fail data in plain language).
# Get one at https://console.anthropic.com/settings/keys.
# Leave blank and reports simply won't include a narrative section.
ANTHROPIC_API_KEY=

# Base URL used to build links back to this app inside Discord alert
# messages. Set this to your deployed URL in production, e.g.
# https://your-app.onrender.com — otherwise those links point at localhost.
APP_BASE_URL=http://localhost:5173

# Port the Express server listens on. Render (and most hosts) set this
# automatically — you normally don't need to set it yourself.
PORT=3001
